# ============================================================
#  M4 CMS — Seguridad
#  Bloquea ficheros sensibles antes de cualquier rewrite.
# ============================================================
<IfModule mod_authz_core.c>
    # Dotfiles: .env, .setup_completed, .admin_hash, .manifest.json...
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
    # Bases de datos y backups
    <FilesMatch "\.(db|sqlite|sqlite3|bak)$">
        Require all denied
    </FilesMatch>
    # Utilidades sensibles u obsoletas
    <FilesMatch "^(admin_config|install|cleanup|fix-bom)\.php$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "\.(db|sqlite|sqlite3|bak)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "^(admin_config|install|cleanup|fix-bom)\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Cabeceras de seguridad (mod_headers). setup.php y apply-admin-path.php NO se
# bloquean aquí: setup.php es el instalador (se autoprotege con .setup_completed
# y se autoelimina) y apply-admin-path.php exige sesión de admin + token de un
# solo uso. Bloquearlos rompería la instalación y el cambio de ruta del panel.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https://www.youtube-nocookie.com https://player.vimeo.com https://www.dailymotion.com https://w.soundcloud.com https://open.spotify.com; form-action 'self'; base-uri 'self'; frame-ancestors 'self'"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

RewriteEngine On

# Página genérica para URLs inexistentes
ErrorDocument 404 /404.php

# Página propia para accesos denegados (mantiene el estado HTTP 403)
ErrorDocument 403 /404.php

# Directorios internos: acceso web prohibido (403 -> página de error propia)
RewriteRule ^db(/|$) - [F,L]
RewriteRule ^(helpers|templates)(/|$) - [F,L]
# Dotdirs peligrosos (.git, .aider...) sin bloquear .well-known (necesario para SSL)
RewriteRule ^\.(?!well-known(/|$))[^/]+(/|$) - [F,L]

# Redireccion 301: /post/mi-slug -> /mi-slug (para compatibilidad con URLs antiguas)
RewriteRule ^post/([a-z0-9\-]+)/?$ /$1 [R=301,L]

# Pagina principal: /page/2 -> index.php?page=2
RewriteRule ^page/([0-9]+)/?$ index.php?page=$1 [L,QSA]

# RSS feed
RewriteRule ^feed/?$ rss.php [L]

# Sitemap
RewriteRule ^sitemap\.xml/?$ sitemap.php [L]

# Entrada en la raiz (estilo WordPress "Nombre de la entrada"): /mi-slug -> post.php?slug=mi-slug
# Debe ser la ultima regla: solo aplica si no es un archivo o carpeta real
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9\-]+)/?$ post.php?slug=$1 [L,QSA]
